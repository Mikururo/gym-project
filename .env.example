POSTGRES_DB=gymdb
POSTGRES_USER=gymuser
POSTGRES_PASSWORD=change_me

# Generate long random values before running outside a local demo environment.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Optional: creates an administrator account on auth-service startup.
# Leave all three blank if an administrator account is not required.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
